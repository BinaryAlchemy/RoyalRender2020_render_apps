[If] <CustomRR_OC_EXT_FLAG>  [==]
    [If] <ImageExtension>  [==] .exr
        RR_OC_EXT_FLAG= --output-exr16
    [EndIf] 
    [If] <ImageExtension>  [==] .png
        RR_OC_EXT_FLAG= --output-png
    [EndIf] 
[Else]
    RR_OC_EXT_FLAG= --output-<CustomRR_OC_EXT_FLAG>
[EndIf] 

echo * RR_OC_EXT_FLAG is set to <RR_OC_EXT_FLAG>


