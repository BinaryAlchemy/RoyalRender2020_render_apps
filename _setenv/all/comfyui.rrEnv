echo * ------ comfyui.rrEnv version %rrVersion% ------

# !!!!!!!!!DO NOT EDIT THIS FILE!!!!!!!! !!!!!!!!!DO NOT EDIT THIS FILE!!!!!!!! !!!!!!!!!DO NOT EDIT THIS FILE!!!!!!!!

# Please create/edit the ...__inhouse.rrEnv file instead

# If this is not possible, PLEASE CONTACT support@RoyalRender.de
# We will send you an update rrEnv file that will work

# "but I know what I am doing"....  Still " NO! NO! NO!"
# It is not about you knowing that it will work, it is about RR updates/bug fixes might not work because of you.
# And if you need a bug fix for an urgent render, we cannot help you any more.
# And if you want to update RR to e.g. support a new render app version, your whole farm could break.

# !!!!!!!!!DO NOT EDIT THIS FILE!!!!!!!! !!!!!!!!!DO NOT EDIT THIS FILE!!!!!!!! !!!!!!!!!DO NOT EDIT THIS FILE!!!!!!!!



#There was a ComfyUI custom_node that printed unicode Emojis.
#And this crashed the logger at it was not able to convert that letter into the console encodings\cp1252.py.
#Using UTF8 works fine and is shown as Emoji in rrControl as well
PYTHONUTF8 = 1



echo * COLocalSyncModels is set to <COLocalSyncModels>
echo * COLocalSyncNodes is set to <COLocalSyncNodes>
echo * CustomModelDir is set to <CustomModelDir>
echo * CustomNodesDir is set to <CustomNodesDir>


#If one artist uses local copy and on other does not, then we need a clear folder without models
RR_COMFYUI_BASE_LOCAL = <rrLocalPlugins>clear_base<rrJobVerMajor>
[If] <COLocalSyncModels> [==] 1
    RR_COMFYUI_BASE_LOCAL = <rrLocalPlugins>model_base<rrJobVerMajor>
[EndIf]
RR_COMFYUI_MODELS_LOCAL = <RR_COMFYUI_BASE_LOCAL>/models
RR_COMFYUI_NODES_LOCAL = <RR_COMFYUI_BASE_LOCAL>/custom_nodes


[If] <RR_COMFYUI_MODELS>  [==] 
    RR_COMFYUI_MODELS = <CustomModelDir>
[EndIf]
[If] <RR_COMFYUI_MODELS>  [==] 
    RR_COMFYUI_MODELS = <rrPluginsNoOS><rrJobVerMajor>/models
[EndIf]
echo * ComfyUI source models path is set to <RR_COMFYUI_MODELS>

[If] <RR_COMFYUI_NODES>  [==] 
    RR_COMFYUI_NODES = <CustomNodesDir>
[EndIf]
[If] <RR_COMFYUI_NODES>  [==] 
    RR_COMFYUI_NODES = <rrPluginsNoOS><rrJobVerMajor>/custom_nodes
[EndIf]
echo * ComfyUI source custom_nodes path is set to <RR_COMFYUI_NODES>


[If] <COLocalSyncModels> [==] 1
    [copy] SyncCreateDir <RR_COMFYUI_MODELS>  =>   <RR_COMFYUI_MODELS_LOCAL>
[EndIf]

[If] <COLocalSyncNodes> [==] 1
    [copy] SyncCreateDir <RR_COMFYUI_NODES>   =>   <RR_COMFYUI_NODES_LOCAL>
[EndIf]




#if the job has not set an ModelConfigYaml, then ComfyUI uses RR_COMFYUI_BASE_LOCAL/models and RR_COMFYUI_BASE_LOCAL/custom_nodes by default
#But if we do not copy the models or custom_nodes locally, then we need to create a ModelConfigYaml that links to the network share

[If] <RR_COMFYUI_MODEL_YAML>  [==] 
    RR_COMFYUI_MODEL_YAML = <CustomModelConfigYaml>
[EndIf]

[If] <RR_COMFYUI_MODEL_YAML>  [==] 
    RR_COMFYUI_MODEL_YAML = <rrLocalTemp>extra_model_paths.yaml

    echo all: > <RR_COMFYUI_MODEL_YAML>
    [If] <COLocalSyncModels> [==] 0
        echo "  models: <RR_COMFYUI_MODELS>" >> <RR_COMFYUI_MODELS>
    [EndIf]
    
    [If] <COLocalSyncNodes> [==] 1
        echo "  custom_nodes: <RR_COMFYUI_NODES>"  >> <RR_COMFYUI_MODEL_YAML>
    [EndIf]


[EndIf]



